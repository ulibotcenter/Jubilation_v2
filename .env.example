# Optional cloud account + encrypted vault.
# Without these, the app works on-device only (encrypted .json backup/restore).
#
# Hosting is EU from day 1. Vercel functions are pinned to Frankfurt (`fra1`)
# in vercel.json. Create Postgres in the EU (Neon eu-central-1 / Frankfurt,
# Supabase EU, RDS eu-central-1). Do not use a US-only vendor.
# `tenant.data_region` defaults to `eu`. `br` is reserved and not live.

# Required to enable account + plan sync.
# When both are set, a signed-in user stores email, plan tier, preferred
# country / language / currency, and the retirement plan in Postgres.
# Plan tier changes only via the Stripe webhook — never from the browser.
DATABASE_URL=postgres://user:pass@host:5432/jubilation
AUTH_SECRET=

# Public origin used in magic-link emails (https://app.example.com)
AUTH_URL=

# Optional kill switch
# AUTH=off

# Magic-link delivery. The sender is SMTP; without SMTP_HOST and EMAIL_FROM
# the link is not sent (password login still works). Tests never open an inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Set to disable TLS for local Postgres
# DATABASE_SSL=disable

# Optional Stripe billing. Off unless secret + webhook secret + at least one
# STRIPE_PRICE_* id exist, and cloud account (DATABASE_URL + AUTH_SECRET) is on.
# PlanTier is set by the webhook on the server — never by a click in the UI.
#
# Prefer a Stripe account in Brazil:
# https://docs.stripe.com/brazil
# Do not require a US entity. Two products only (Individual, Couple), each with
# Price objects in BRL, USD, and EUR. Unsuffixed ids stay BRL.
#
# Recommendation placeholders to create in Stripe (NOT a frozen business price):
#   Individual yearly  R$ 89 / US$ 19 / € 18
#     → STRIPE_PRICE_PREMIUM_YEARLY (+ _USD / _EUR)
#   Individual monthly R$ 14,90 / US$ 4 / € 3,90  (deliberately expensive)
#     → STRIPE_PRICE_PREMIUM_MONTHLY (+ _USD / _EUR)
#   Couple yearly      R$ 129 / US$ 29 / € 25
#     → STRIPE_PRICE_HORIZON_YEARLY (+ _USD / _EUR)
#
# Webhook endpoint: POST /api/billing/webhook
# Events: checkout.session.completed, customer.subscription.deleted

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_HORIZON_YEARLY=
STRIPE_PRICE_PREMIUM_YEARLY_USD=
STRIPE_PRICE_PREMIUM_MONTHLY_USD=
STRIPE_PRICE_HORIZON_YEARLY_USD=
STRIPE_PRICE_PREMIUM_YEARLY_EUR=
STRIPE_PRICE_PREMIUM_MONTHLY_EUR=
STRIPE_PRICE_HORIZON_YEARLY_EUR=
STRIPE_CURRENCY=brl

# Optional on-screen amounts in cents. Checkout charges the Stripe Price, not these.
# STRIPE_PRICE_PREMIUM_YEARLY_AMOUNT=8900
# STRIPE_PRICE_PREMIUM_MONTHLY_AMOUNT=1490
# STRIPE_PRICE_HORIZON_YEARLY_AMOUNT=12900
# STRIPE_PRICE_PREMIUM_YEARLY_USD_AMOUNT=1900
# STRIPE_PRICE_PREMIUM_MONTHLY_USD_AMOUNT=400
# STRIPE_PRICE_HORIZON_YEARLY_USD_AMOUNT=2900
# STRIPE_PRICE_PREMIUM_YEARLY_EUR_AMOUNT=1800
# STRIPE_PRICE_PREMIUM_MONTHLY_EUR_AMOUNT=390
# STRIPE_PRICE_HORIZON_YEARLY_EUR_AMOUNT=2500

# Optional kill switch
# BILLING=off

# Optional B3 Nova Área Logada (commercial licence, non-financial PJ).
# Not Open Finance. Do not scrape Meu INSS or investidor.b3.com.br.
# Without B3_PRODUCTION_* the app stays on the fixture and says so.
# Certification (sandbox) is a separate host — it is not live custody.
#
# Portal: https://developers.b3.com.br/ → APIs → Nova Área Logada
# Contracting: contratacao@b3.com.br · SAT: sat@b3.com.br
# Production access package is sent by B3 after the contract.
# Confirm current price with B3 — do not treat the 2022 circular as current.

# B3_PRODUCTION_BASE_URL=
# B3_PRODUCTION_ACCESS_TOKEN=
# B3_PRODUCTION_CLIENT_ID=
# B3_PRODUCTION_CLIENT_SECRET=
# B3_PRODUCTION_INVESTOR_DOCUMENT=
# B3_PRODUCTION_TOKEN_PATH=/oauth/token
# Optional after the licence: API Guia / autorização / eventos (no invented hosts)
# B3_PRODUCTION_GUIDE_PATH=
# B3_PRODUCTION_AUTHORIZATION_PATH=
# B3_PRODUCTION_EVENTS_PATH=
# Kill switch — ignore production keys
# B3_LIVE=off

# Certification / sandbox only (not live holdings)
# B3_SANDBOX_BASE_URL=
# B3_SANDBOX_ACCESS_TOKEN=
# B3_SANDBOX_CLIENT_ID=
# B3_SANDBOX_CLIENT_SECRET=
# B3_SANDBOX_INVESTOR_DOCUMENT=
